{
  "name": "capital-guard-server",
  "version": "1.0.0",
  "description": "Capital Guard API Server - Node.js + Fastify + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage",
    "db:backfill:derivatives": "tsx scripts/backfill-derivative-columns.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/websocket": "^11.0.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "breezeconnect": "^1.0.30",
    "bullmq": "^5.70.1",
    "fastify": "^5.0.0",
    "ioredis": "^5.4.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.13",
    "otpauth": "^9.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "axios": "$axios",
    "effect": "^3.20.0",
    "breezeconnect": {
      "csv-parse": "^7.0.3"
    },
    "node-cron": {
      "uuid": "^11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
