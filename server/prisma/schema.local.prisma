// ─── System 2: Market Data Infrastructure ───────────────────────────

/// Known execution failures — the deterministic half of "learn from failure".
///
/// Strategy losses are mostly noise and belong to the statistical layer: a
/// profitable system loses 40-50% of the time, and suppressing those setups would
/// destroy the edge. EXECUTION failures are the opposite — a malformed payload, a
/// missing expiry, an unbalanced spread. One identifiable cause, recurs
/// identically, and "never do this again" is literally correct.
///
/// `fingerprint` deliberately excludes strike, expiry, order id and amounts, or
/// the same defect would never match itself. Whether a recorded failure BLOCKS is
/// decided by its class, not by a count: a malformed order can never succeed and
/// is blocked on the first occurrence, while a broker timeout must never block
/// however often it happens.
model FailureMode {
  fingerprint     String   @id
  failureClass    String   @map("failure_class")
  segment         String
  instrumentType  String   @map("instrument_type")
  underlying      String
  /// Cause with ids, timestamps and amounts stripped, so repeats collapse.
  normalizedCause String   @map("normalized_cause")
  /// One verbatim example, kept for diagnosis.
  sampleCause     String   @map("sample_cause")
  occurrences     Int      @default(1)
  /// When true, a matching order is refused before it reaches the broker.
  blocked         Boolean  @default(false)
  /// Operator note, e.g. why a block was lifted.
  notes           String?
  firstSeenAt     DateTime @map("first_seen_at")
  lastSeenAt      DateTime @map("last_seen_at")

  @@index([blocked])
  @@index([failureClass, lastSeenAt])
  @@map("failure_modes")
}

/// Persistent Bayesian posterior per strategy — the bandit's memory.
///
/// This lived in Redis under `cg:thompson:{userId}:{strategyTag}` with
/// `EX 24*3600`, which meant the posterior EXPIRED DAILY. After one quiet day it
/// reset to {alpha:1, beta:1, emaWinRate:0.5, totalTrades:0} — a uniform prior,
/// i.e. total ignorance — so a strategy with two hundred trades of history became
/// indistinguishable from one that had never traded. The write also began with
/// `if (!redis) return`, silently discarding the update when Redis was absent.
///
/// A reset bandit does not look broken, it looks cautious: it explores and
/// allocates evenly, which reads as sensible risk behaviour rather than amnesia.
/// That is why a one-day half-life on the learning went unnoticed.
///
/// Postgres is the system of record now; Redis may cache reads.
model StrategyPosterior {
  userId      String   @map("user_id")
  strategyTag String   @map("strategy_tag")
  /// Beta distribution shape parameters: wins + 1 and losses + 1.
  alpha       Int      @default(1)
  beta        Int      @default(1)
  /// Recency-weighted win rate. Distinct from alpha/(alpha+beta), which weights
  /// the whole history equally — this is what detects a strategy going stale.
  emaWinRate  Float    @default(0.5) @map("ema_win_rate")
  totalTrades Int      @default(0) @map("total_trades")
  /// Set explicitly rather than via @updatedAt, because the writer is a single
  /// atomic upsert statement rather than a Prisma client mutation.
  updatedAt   DateTime @map("updated_at")

  @@id([userId, strategyTag])
  @@map("strategy_posteriors")
}

/// Historical option-chain snapshots.
///
/// Nothing persisted option-chain data before this, which had two consequences.
/// An options backtest was impossible — there was no premium, IV or OI history to
/// replay. And `calculateIVPercentile` was being handed the IVs across strikes in
/// the CURRENT chain, so it measured where ATM IV sat within today's volatility
/// smile rather than within its own history. Since the wings of a smile always
/// carry higher IV than ATM, that reports a systematically low percentile
/// whatever the vol regime — and it fed both bot decisions and LLM prompts.
model OptionChainSnapshot {
  id              BigInt   @id @default(autoincrement())
  underlying      String
  expiry          DateTime
  strike          Decimal
  optionType      String   @map("option_type") // CE | PE
  /// Spot the exchange priced these premiums against, kept so IV and spot stay
  /// consistent when replayed.
  underlyingValue Decimal? @map("underlying_value")
  ltp             Decimal?
  /// As reported by the exchange, in PERCENT — the same unit the live chain uses.
  iv              Decimal?
  oi              BigInt?
  oiChange        BigInt?  @map("oi_change")
  volume          BigInt?
  bidPrice        Decimal? @map("bid_price")
  askPrice        Decimal? @map("ask_price")
  capturedAt      DateTime @map("captured_at")

  /// One row per contract per capture. Makes the writer idempotent, so a retried
  /// or overlapping snapshot job cannot double-count a strike.
  @@unique([underlying, expiry, strike, optionType, capturedAt])
  @@index([underlying, expiry, capturedAt])
  @@index([underlying, capturedAt])
  @@map("option_chain_snapshots")
}

