  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// API credentials for brokers other than ICICI Breeze (which keeps breeze_credentials).
/// Everything secret is encrypted with ENCRYPTION_KEY. Never a broker password:
/// logins happen on the broker's own site and only the resulting token is kept.
model BrokerAccount {
  id                   String    @id @default(uuid())
  userId               String    @map("user_id")
  broker               String
  encryptedApiKey      String?   @map("encrypted_api_key")
  encryptedApiSecret   String?   @map("encrypted_api_secret")
  encryptedClientId    String?   @map("encrypted_client_id")
  encryptedAccessToken String?   @map("encrypted_access_token")
  tokenExpiresAt       DateTime? @map("token_expires_at")
  /// The broker's own account id (Upstox user_id), learned at the first browser
  /// login. A token pushed to the notifier webhook is accepted only for this id.
  brokerUserId         String?   @map("broker_user_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, broker])
  @@map("broker_accounts")
}

/// Automatic exit for a multi-leg strategy placed from the Strategy Builder:
/// close every leg when the P&L after charges reaches the target or the stop,
/// or at a set time.
model StrategyExitPlan {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  strategyTag  String    @map("strategy_tag")
  /// Rupees after charges
  targetRupees Float?    @map("target_rupees")
  /// Rupees after charges (a positive number: the most to lose)
  stopRupees   Float?    @map("stop_rupees")
  exitAt       DateTime? @map("exit_at")
  /// ACTIVE | DONE | CANCELLED
  status       String    @default("ACTIVE")
  reason       String?
  closedPnl    Float?    @map("closed_pnl")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([userId, strategyTag])
  @@index([status])
  @@map("strategy_exit_plans")
}

/// One options-strategy backtest run (Rust engine), kept so it can be reopened.
model OptionBacktestRun {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  underlying String
  dateFrom   String   @map("date_from")
  dateTo     String   @map("date_to")
  /// JSON: the rules that were tested
  params     String
  /// JSON: totals, win rate, drawdown, charges
  summary    String
  /// JSON: every simulated trade
  trades     String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("option_backtest_runs")
}
